---
layout: layouts/base.njk
---
{# Only include the syntax highlighter CSS on blog posts, included with the CSS per-page bundle #}
<style>{% include "node_modules/prismjs/themes/prism-okaidia.css" %}</style>
<style>{% include "css/prism-diff.css" %}</style>
<article class="article">
	<header class="article-header">
		<h1>{{ title }}</h1>
		{%- if description %}<p class="article-desc">{{ description }}</p>{% endif %}
		<ul class="post-metadata">
			<li><time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate("LLLL d, yyyy") }}</time></li>
			<li>·</li>
			<li>{{ content | readingTime }} min read</li>
			<li>·</li>
			<li title="Views of this post">👁 <span class="view-count" data-slug="{{ page.fileSlug }}" data-hit>1,000</span> views</li>
			<li class="tags">
			{%- for tag in tags | filterTagList %}
				{%- set tagUrl %}/tags/{{ tag | slugify }}/{% endset %}
				<a href="{{ tagUrl }}" class="post-tag">{{ tag }}</a>
			{%- endfor %}
			</li>
		</ul>
	</header>

	<nav class="toc" id="toc" aria-label="Table of contents" hidden>
		<p class="toc-title">On this page</p>
		<ol></ol>
	</nav>

	<div class="article-body">
		{{ content | safe }}
	</div>

	{%- if collections.posts %}
	{%- set previousPost = collections.posts | getPreviousCollectionItem %}
	{%- set nextPost = collections.posts | getNextCollectionItem %}
	{%- if nextPost or previousPost %}
	<ul class="links-nextprev">
		{%- if previousPost %}<li class="links-nextprev-prev">← Previous<a href="{{ previousPost.url }}">{{ previousPost.data.title }}</a></li>{% endif %}
		{%- if nextPost %}<li class="links-nextprev-next">Next →<a href="{{ nextPost.url }}">{{ nextPost.data.title }}</a></li>{% endif %}
	</ul>
	{%- endif %}
	{%- endif %}
</article>

{#- On-demand client-side rendering for Mermaid diagrams #}
<script type="module">
	const mermaidCodes = document.querySelectorAll('pre > code.language-mermaid, pre.language-mermaid');
	if (mermaidCodes.length > 0) {
		const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
		
		const getTheme = () => document.documentElement.getAttribute('data-theme') === 'light' ? 'default' : 'dark';

		const diagrams = [];
		mermaidCodes.forEach((codeEl, index) => {
			const pre = codeEl.closest('pre');
			if (pre && !pre.dataset.processed) {
				pre.dataset.processed = "true";
				const rawCode = (codeEl.tagName === 'CODE' ? codeEl.textContent : pre.textContent).trim();
				const container = document.createElement('div');
				container.className = 'mermaid';
				container.id = 'mermaid-block-' + index;
				container.dataset.raw = rawCode;
				pre.parentNode.replaceChild(container, pre);
				diagrams.push(container);
			}
		});

		async function renderMermaid() {
			mermaid.initialize({
				startOnLoad: false,
				theme: getTheme(),
				themeVariables: {
					darkMode: getTheme() === 'dark',
					fontFamily: 'Inter, system-ui, sans-serif'
				}
			});

			for (const container of diagrams) {
				const id = 'svg-' + container.id + '-' + Math.random().toString(36).substring(2, 8);
				try {
					const { svg } = await mermaid.render(id, container.dataset.raw);
					container.innerHTML = svg;
				} catch (err) {
					console.error('Mermaid render error:', err);
					container.innerHTML = '<pre><code>' + container.dataset.raw + '</code></pre>';
				}
			}
		}

		await renderMermaid();

		// Re-render when theme toggles
		document.getElementById('theme-toggle')?.addEventListener('click', () => {
			setTimeout(renderMermaid, 60);
		});
	}
</script>
