<ol reversed class="postlist{% if featured %} featured{% endif %}">
{%- for post in postslist | reverse %}
	<li class="postlist-item{% if post.url == url %} postlist-item-active{% endif %}">
		<div class="postlist-meta">
			<time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate("LLL d, yyyy") }}</time>
			<span>·</span>
			<span>{{ post.templateContent | readingTime }} min read</span>
			<span>·</span>
			<span title="Views">👁 <span class="view-count" data-slug="{{ post.fileSlug }}">1,000</span></span>
		</div>
		<a href="{{ post.url }}" class="postlist-link">{% if post.data.title %}{{ post.data.title }}{% else %}<code>{{ post.url }}</code>{% endif %}</a>
		{%- if post.data.description %}<p class="postlist-desc">{{ post.data.description }}</p>{% endif %}
		<div class="postlist-tags">
		{%- for tag in post.data.tags | filterTagList %}
			<a href="/tags/{{ tag | slugify }}/" class="post-tag">{{ tag }}</a>
		{%- endfor %}
		</div>
	</li>
{%- endfor %}
</ol>
