<h1>Tags</h1>

<ul class="hero-tags" style="gap:0.75rem">
{% for tag in collections | getKeys | filterTagList | sortAlphabetically %}
	{% set tagUrl %}/tags/{{ tag | slugify }}/{% endset %}
	<li><a href="{{ tagUrl }}" class="post-tag" style="font-size:0.95rem;padding:0.4em 1em">{{ tag }}</a></li>
{% endfor %}
</ul>
